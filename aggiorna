if ! sudo -v; then
    exit_clean "   ${RED}✗ Authentication failed. Exiting.${RESET}" 1
fi
( while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) 2>/dev/null &
SUDO_PID=$!

printf '\e[?25l'                                        # hide the cursor
START_AVAIL=$(df --output=avail / | tail -1 | tr -d ' ')

# Resolve everything first (one metadata refresh), so the TOTAL bar is exact.
plan_phase

# A staged offline transaction (Discover's "update and restart") holds the very
# packages the live upgrade below is about to install: drop it first.
if (( OFFLINE_PENDING )); then
    run_step "Clearing the staged offline update (installed live below)" _clear_offline
fi

# The upgrade reuses the metadata just refreshed during planning (no --refresh).
# Each step is handed its slice of the TOTAL bar computed in plan_phase.
run_dnf      "System upgrade (DNF)"        "Install" 0          "$B_DLU_HI" "$B_DLU_HI" "$B_INU_HI" sudo "${UNBUF[@]}" env LC_ALL=C dnf upgrade -y
run_dnf      "Removing orphaned packages"  "Remove"  "$B_INU_HI" "$B_INU_HI" "$B_INU_HI" "$B_INA_HI" sudo "${UNBUF[@]}" env LC_ALL=C dnf autoremove -y
run_flatpak  "Updating Flatpaks"           update "$B_INA_HI" "$B_FPU_HI" "${FU_REFS[@]}"
run_flatpak  "Removing unused Flatpaks"    remove "$B_FPU_HI" "$B_FPX_HI" "${FX_REFS[@]}"
# Firmware last: dnf may have just updated fwupd itself. Il firmware viene
# installato senza conferma e senza gli avvisi del produttore: fwupd li
# disattiva da sé quando il suo stdout non è un terminale (vedi run_fw).
run_fw       "Firmware update (fwupd)"     "$B_FPX_HI" 1000     "${FW_IDS[@]}"

# Optional hook: cromup (Cromite) — excluded from the overall progress bar
if [ -x /usr/local/bin/cromup ]; then
    run_step "Updating Cromite (cromup)" cromup
fi

END_AVAIL=$(df --output=avail / | tail -1 | tr -d ' ')
teardown_footer

# Fra l'ultimo nodo della pipeline e la scheda di resoconto ci sono due passi
# che non disegnano niente: l'analisi del riavvio (che interroga tutto l'rpmdb,
# appena riscritto da dnf) e l'autoaggiornamento via rete. Se uno dei due va per
# le lunghe, lo schermo resta fermo sull'ultimo nodo senza spiegare perché — e
# uno schermo fermo e muto è indistinguibile da uno script piantato. Una riga,
# almeno, dice a che punto siamo.
printf '   %s┃%s\n' "$DIM" "$RESET"
printf '   %s⋯  controlli finali e autoaggiornamento…%s\n' "$DIM" "$RESET"

# Everything that only takes effect after a restart (kernel, core libs, firmware)
trace "inizio: analisi riavvio"
detect_reboot_needed || true
trace "fine:   analisi riavvio (${#REBOOT_REASONS[@]} motivi)"

#== Script self-update ======================================================
# Timeout espliciti: senza, un mirror che non risponde lascia curl appeso a
# tempo indefinito proprio qui, con lo schermo che non dice niente. L'altra
# sonda di rete (next_release) un --max-time ce l'aveva già.
trace "inizio: autoaggiornamento"
if curl -fsSL --connect-timeout 10 --max-time 60 \
        https://raw.githubusercontent.com/RootGPT-YouTube/FedoraUP/main/aggiorna -o /tmp/aggiorna.tmp 2>/dev/null; then
    if ! cmp -s /tmp/aggiorna.tmp /usr/local/bin/aggiorna 2>/dev/null; then
        if sudo mv /tmp/aggiorna.tmp /usr/local/bin/aggiorna && sudo chmod a+x /usr/local/bin/aggiorna; then
            SCRIPT_UPDATE='updated ✓'
        else
            SCRIPT_UPDATE='error ✗'
        fi
    else
        SCRIPT_UPDATE='already up to date'
        rm -f /tmp/aggiorna.tmp
    fi
else
    rm -f /tmp/aggiorna.tmp
    SCRIPT_UPDATE='not checked'
fi
trace "fine:   autoaggiornamento ($SCRIPT_UPDATE)"

#== Report ==================================================================
report_card

#== Reboot-class updates ====================================================
if (( ${#REBOOT_REASONS[@]} > 0 )); then
    printf '   %s⟳  A REBOOT IS REQUIRED to complete this update:%s\n' "$GOLD$BOLD" "$RESET"
    for reason in "${REBOOT_REASONS[@]}"; do
        printf '      %s•%s %s\n' "$GOLD" "$RESET" "$reason"
    done
    echo
fi

#== Optional Fedora version jump (offered last, once everything else is done) =
if [ -n "$NEXT_REL" ]; then
    CUR_REL=$(rpm -E %fedora)
    printf '   %s▲  Fedora %s is out — this system is on Fedora %s.%s\n' \
        "$CYAN$BOLD" "$NEXT_REL" "$CUR_REL" "$RESET"
    printf '      %sThe jump downloads the whole new release now and installs it during a reboot.%s\n' \
        "$DIM" "$RESET"
    printf '      %sIt is optional: everything above is already up to date without it.%s\n' \
        "$DIM" "$RESET"
    if ask_yes_no "Upgrade to Fedora $NEXT_REL?"; then
        echo
        fails_before=$steps_fail
        NO_AUTOREPAIR=1                    # a depsolve refusal here is an answer, not damage
        setup_footer; FIRST_STEP=1; G_TOTAL_PKG=0
        run_dnf "Downloading Fedora $NEXT_REL" "Install" 0 900 900 1000 \
            sudo "${UNBUF[@]}" env LC_ALL=C dnf -y --releasever="$NEXT_REL" system-upgrade download
        teardown_footer
        NO_AUTOREPAIR=0
        if (( steps_fail == fails_before )); then
            SYSUP_STAGED=1
        else
            printf '\n      %sThe download failed. Third-party packages with no Fedora %s build are\n' \
                "$DIM" "$NEXT_REL"
            printf '      the usual cause; retry by hand with:%s\n' "$RESET"
            printf '      %ssudo dnf --releasever=%s --allowerasing system-upgrade download%s\n\n' \
                "$BOLD" "$NEXT_REL" "$RESET"
        fi
    else
        printf '      %sSkipped — staying on Fedora %s.%s\n\n' "$DIM" "$CUR_REL" "$RESET"
    fi
fi

#== Reboot proposal =========================================================
if (( SYSUP_STAGED )); then
    printf '   %s⟳  Fedora %s is downloaded; the upgrade itself runs during the reboot.%s\n' \
        "$GOLD$BOLD" "$NEXT_REL" "$RESET"
    if ask_yes_no "Reboot now and install Fedora $NEXT_REL?"; then
        printf '\n   %sRebooting…%s\n' "$DIM" "$RESET"
        sudo env LC_ALL=C dnf system-upgrade reboot
        exit 0
    fi
    printf '      %sWhen you are ready: sudo dnf system-upgrade reboot%s\n\n' "$DIM" "$RESET"
elif (( ${#REBOOT_REASONS[@]} > 0 )); then
    if ask_yes_no "Reboot now?"; then
        printf '\n   %sRebooting…%s\n' "$DIM" "$RESET"
        sudo systemctl reboot
        exit 0
    fi
    printf '      %sRemember to reboot to finish applying the update.%s\n\n' "$DIM" "$RESET"
fi

#== Exit ====================================================================
trace "uscita normale"
[ -n "$DEBUG_DIR" ] && printf '   %sDiario di questa esecuzione: %s%s\n' "$DIM" "$DEBUG_DIR" "$RESET"
printf '\e[?25h'
printf '   %s↵ Press ENTER to close%s' "$DIM" "$RESET"
ask_read _close
clear
[ -n "$DEBUG_DIR" ] && printf 'Diario di aggiorna: %s\n' "$DEBUG_DIR"
# == End of script ==
