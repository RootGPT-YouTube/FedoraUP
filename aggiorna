#!/bin/bash
#
# aggiorna — Fedora (non-immutable) maintenance & update helper
# by R∞tGPT — original "pipeline" interface (unrelated to Nala)
#

#== Colors (real ESC, so they work both with printf and echo) ================
RESET=$'\e[0m'
BOLD=$'\e[1m'
DIM=$'\e[38;2;96;106;128m'      # slate-grey for the rules
GREEN=$'\e[38;2;80;220;130m'
RED=$'\e[38;2;255;95;95m'
CYAN=$'\e[38;2;0;220;210m'
GOLD=$'\e[38;2;255;200;90m'

#== Global state =============================================================
steps_ok=0
steps_fail=0
SCRIPT_UPDATE='—'
FIRST_STEP=1

# The TOTAL bar runs on a fixed 0..1000 per-mille scale split into three phase
# bands — download / install / flatpak — weighted 30/40/30 of the whole bar
# (planned up-front in plan_phase). A phase with no work has its weight handed
# to the phases that do, so the bar always spans a full 0→100% with no stalls.
G_TOTAL_PKG=0    # total packages across every section (Cromite excluded) — label only

# Pre-resolved plan (filled by plan_phase)
DNF_UPG=0
DNF_AUTO=0
FU_REFS=()       # Flatpak refs to update
FX_REFS=()       # unused Flatpak refs to remove
FW_IDS=()        # fwupd device IDs with a firmware update pending
FW_NAMES=()      # human names, index-aligned with FW_IDS

# Reboot-class updates (see the "reboot" section at the bottom)
OFFLINE_PENDING=0   # an offline/staged transaction (Discover) is waiting for a reboot
NEXT_REL=''         # next Fedora release available for a version jump ('' = none)
SYSUP_STAGED=0      # a system-upgrade has been downloaded and awaits the reboot
REBOOT_REASONS=()   # why a reboot is needed, filled by detect_reboot_needed

# Per-mille band boundaries on the TOTAL bar (filled by plan_phase). Each section
# fills its [lo,hi] slice; boundaries are contiguous so the bar never jumps back.
B_DLU_HI=300     # download (DNF upgrade):  0 .. B_DLU_HI
B_INU_HI=500     # install, upgrade share:  B_DLU_HI .. B_INU_HI
B_INA_HI=700     # install, autoremove:     B_INU_HI .. B_INA_HI
B_FPU_HI=850     # flatpak update share:    B_INA_HI .. B_FPU_HI
B_FPX_HI=900     # flatpak remove share:    B_FPU_HI .. B_FPX_HI
                 # firmware (fwupd) share:  B_FPX_HI .. 1000

# Live block bookkeeping
LIVE_DRAWN=0
LIVE_LINES=3
SPIN=('◜' '◠' '◝' '◞' '◡' '◟')   # rotating arc (not braille!)

# Terminal geometry for the fixed TOTAL footer (bottom 2 reserved rows)
TERM_ROWS=24
TERM_COLS=80

#== Diario di bordo (facoltativo) ===========================================
# `AGGIORNA_DEBUG=1 aggiorna` tiene un diario in /tmp/aggiorna-debug-<pid>/:
# una riga con l'ora a ogni passo e a ogni domanda, più l'output completo di
# ogni comando, che di norma viene buttato via appena il passo finisce.
#
# Serve per una cosa sola, ma importante: quando lo script *sembra* fermo e lo
# schermo non dice perché, il diario dice a che punto era arrivato, a che ora, e
# che cosa stava aspettando. Senza, di un blocco non resta alcuna traccia.
DEBUG_DIR=''
if [ -n "${AGGIORNA_DEBUG:-}" ]; then
    DEBUG_DIR="/tmp/aggiorna-debug-$$"
    mkdir -p "$DEBUG_DIR" 2>/dev/null || DEBUG_DIR=''
fi

trace() {
    [ -n "$DEBUG_DIR" ] || return 0
    printf '%s  %s\n' "$(date '+%H:%M:%S')" "$1" >> "$DEBUG_DIR/diario.txt"
}

# Fine di un passo: butta il log com'e' sempre stato, ma se il diario e' attivo
# lo conserva prima, con il nome del passo.
drop_log() {
    local log=$1 label=$2
    if [ -n "$DEBUG_DIR" ] && [ -s "$log" ]; then
        cp "$log" "$DEBUG_DIR/$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '_').log" 2>/dev/null
    fi
    trace "fine:   $label"
    rm -f "$log"
}

#== Utilities ================================================================

# repeat a (possibly multibyte) character n times
rep() { local n=$1 ch=$2 i; for ((i=0; i<n; i++)); do printf '%s' "$ch"; done; }

# write text applying a truecolor gradient from (r1,g1,b1) to (r2,g2,b2)
grad_text() {
    local text="$1" r1=$2 g1=$3 b1=$4 r2=$5 g2=$6 b2=$7
    local len=${#text} i r g b den
    den=$(( len > 1 ? len - 1 : 1 ))
    for ((i=0; i<len; i++)); do
        r=$(( r1 + (r2 - r1) * i / den ))
        g=$(( g1 + (g2 - g1) * i / den ))
        b=$(( b1 + (b2 - b1) * i / den ))
        printf '\e[1m\e[38;2;%d;%d;%dm%s' "$r" "$g" "$b" "${text:i:1}"
    done
    printf '%s' "$RESET"
}

fmt_time() { printf '%02d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }

kb_to_human() {
    local kb=$1 sign=''
    (( kb < 0 )) && { sign='-'; kb=$(( -kb )); }
    if   (( kb >= 1048576 )); then printf '%s%d.%d GiB' "$sign" $(( kb/1048576 )) $(( (kb%1048576)*10/1048576 ))
    elif (( kb >= 1024    )); then printf '%s%d MiB' "$sign" $(( kb/1024 ))
    else                           printf '%s%d KiB' "$sign" "$kb"
    fi
}

# percentage done/total (0 when total is unknown)
pct() { local d=$1 t=$2; (( t <= 0 )) && { printf '0'; return; }; printf '%d' $(( d * 100 / t )); }

# a [██████░░░░] progress bar of the given width
draw_bar() {
    local d=$1 t=$2 w=$3 fill
    if (( t <= 0 )); then fill=0; else fill=$(( d * w / t )); fi
    (( fill > w )) && fill=$w; (( fill < 0 )) && fill=0
    printf '%s[%s%s%s%s%s]%s' \
        "$DIM" "$CYAN" "$(rep $fill '█')" "$DIM" "$(rep $(( w - fill )) '─')" "$DIM" "$RESET"
}

# extract the package/label from a "[n/m] NAME   100% | speed | size | time" line,
# cutting exactly before the metrics field (the name may be truncated to the column,
# leaving only a single trailing space, so a double-space cut is not reliable)
clean_name() {
    local rest="$1"
    if [[ $rest =~ ^(.+[^[:space:]])[[:space:]]+[0-9]+%[[:space:]]\| ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    else
        printf '%s' "${rest%%  *}"
    fi
}

# strip the English action verb so only the package name is shown
strip_verb() {
    local s="$1" v
    for v in 'Installing ' 'Upgrading ' 'Reinstalling ' 'Downgrading ' \
             'Removing ' 'Obsoleting ' 'Cleanup ' 'Verifying ' 'Running scriptlet: '; do
        [[ $s == "$v"* ]] && { printf '%s' "${s#"$v"}"; return; }
    done
    printf '%s' "$s"
}

#== Gradient header ==========================================================
header() {
    local width
    width=$(( TERM_COLS < 56 ? TERM_COLS : 56 ))
    (( width < 24 )) && width=24
    local bar; bar=$(rep $(( width - 4 )) '━')

    echo
    printf '  '; grad_text "$bar" 60 110 200 0 220 210; echo
    printf '   '; grad_text "U P D A T E" 70 130 230 0 220 200
    printf '    %s•%s  ' "$DIM" "$RESET"; grad_text "R∞tGPT" 0 220 200 180 90 255; echo
    printf '  '; grad_text "$bar" 0 220 210 60 110 200; echo
    echo
}

#== Fixed TOTAL footer (reserved bottom rows, outside the scroll region) ======
setup_footer() {
    TERM_ROWS=$(tput lines 2>/dev/null || echo 24)
    TERM_COLS=$(tput cols  2>/dev/null || echo 80)
    (( TERM_ROWS < 8 )) && TERM_ROWS=8
    printf '\e[1;%dr' $(( TERM_ROWS - 2 ))     # scroll region: rows 1 .. ROWS-2
    printf '\e[1;1H'                           # cursor back to the top
    draw_total_footer 0
}

teardown_footer() {
    printf '\e7'                               # save the content cursor
    printf '\e[%d;1H\e[K' $(( TERM_ROWS - 1 )) # clear the rule row
    printf '\e[%d;1H\e[K' "$TERM_ROWS"         # clear the bar row
    printf '\e[r'                              # restore full scroll region
    printf '\e8'                               # back to the content cursor
}

# redraw the pinned TOTAL bar; argument = overall progress in per-mille (0..1000)
# on the fixed phase-band scale. Uses absolute positioning + save/restore so it
# never disturbs the scrolling pipeline above it.
draw_total_footer() {
    local pm=$1
    (( pm < 0 )) && pm=0; (( pm > 1000 )) && pm=1000
    local w=$(( TERM_COLS - 34 )); (( w > 40 )) && w=40; (( w < 8 )) && w=8
    printf '\e7'
    printf '\e[%d;1H%s%s%s\e[K' $(( TERM_ROWS - 1 )) "$DIM" "$(rep $(( TERM_COLS > 2 ? TERM_COLS - 2 : 1 )) '─')" "$RESET"
    printf '\e[%d;1H' "$TERM_ROWS"
    printf '   %sTOTAL%s  %s  %s%3s%%%s   %s%d packages%s\e[K' \
        "$BOLD" "$RESET" "$(draw_bar "$pm" 1000 "$w")" \
        "$BOLD" "$(pct "$pm" 1000)" "$RESET" \
        "$DIM" "$G_TOTAL_PKG" "$RESET"
    printf '\e8'
}

# Uscita anticipata (disclaimer rifiutato, autenticazione fallita): libera le
# righe riservate al footer, ripristina la scroll region e pulisce lo schermo —
# altrimenti header, footer e testo restano a sporcare il terminale. Lo schermo
# viene lasciato pulito come alla chiusura normale, con la sola riga di esito.
exit_clean() {
    local msg="$1" rc="${2:-0}"
    teardown_footer
    printf '\e[r'                              # scroll region di nuovo piena
    printf '\e[?25h'                           # cursore visibile
    printf '\e[H\e[2J\e[3J'                    # come `clear`, ma senza dipendere dal binario
    printf '%s\n' "$msg"
    exit "$rc"
}

#== Pipeline drawing =========================================================

# vertical connector between two pipeline nodes
connector() {
    if (( FIRST_STEP )); then FIRST_STEP=0; else printf '   %s┃%s\n' "$DIM" "$RESET"; fi
}

# redraw the live 3-line block (spinner node + counter + section bar);
# sd/st are the section progress as done/total of any matching scale
render_live() {
    local spin=$1 label=$2 el=$3 counter=$4 sd=$5 st=$6
    (( LIVE_DRAWN )) && printf '\e[%dA' "$LIVE_LINES"
    LIVE_DRAWN=1
    printf '\r   %s%s%s  %s   %s%s%s\e[K\n' "$CYAN" "$spin" "$RESET" "$label" "$DIM" "$el" "$RESET"
    printf '\r      %s%s%s\e[K\n' "$DIM" "$counter" "$RESET"
    printf '\r      %ssection%s %s %s%3s%%%s\e[K\n' "$DIM" "$RESET" "$(draw_bar "$sd" "$st" 22)" "$DIM" "$(pct "$sd" "$st")" "$RESET"
}

# collapse the live block into a single result node line
finish_node() {
    local sym=$1 color=$2 label=$3
    (( LIVE_DRAWN )) && printf '\e[%dA' "$LIVE_LINES"
    printf '\r   %s%s%s  %s\e[K\n' "$color" "$sym" "$RESET" "$label"
    (( LIVE_DRAWN )) && printf '\e[J'
    LIVE_DRAWN=0
}

# error box with the tail of the command log
error_box() {
    local log=$1
    printf '   %s┃%s\n' "$DIM" "$RESET"
    printf '   %s┗━ error detail ─────────────────────────────%s\n' "$RED" "$RESET"
    tail -n 8 "$log" | sed "s/^/      ${DIM}│${RESET} /"
    printf '   %s──────────────────────────────────────────────%s\n' "$RED" "$RESET"
}

#== Interactive questions from a running command ==============================
# A command that stops mid-line (no trailing newline) is waiting for an answer
# on the terminal — e.g. fwupd or a GPG key import. Its stdin IS the terminal,
# so the user can reply directly: we only need to surface the hidden prompt,
# show the cursor, and freeze the live UI until the command resumes.
#
# Two detectors run side by side, because a prompt reaches us in two shapes:
#   1. unterminated line — "Perform operation? [Y|n]: " with no newline; the
#      log stops growing mid-line (fast trigger, ~1.8 s).
#   2. terminated line — some tools print the question WITH a newline and then
#      block on read(). Nothing is left pending, so shape 1 never fires: we
#      instead watch for a long silence whose last complete line reads like a
#      question (slow trigger, ~20 s, so it can't misfire on a slow step).
QUIET_TICKS=167                     # ~20 s at the 0.12 s poll interval

# Both detectors only see what actually leaves the command. Writing to a pipe
# switches stdio to block buffering, which can hold a question — printed without
# a trailing newline, so nothing forces a flush — inside the buffer until much
# later output fills it: the user would sit in front of a frozen bar answering
# nothing. Running the command unbuffered removes that failure mode entirely.
# Note sudo drops LD_PRELOAD, so stdbuf must sit *inside* sudo to have an effect.
# Empty (and everything behaves as before) if stdbuf is not installed.
UNBUF=()
command -v stdbuf >/dev/null 2>&1 && UNBUF=(stdbuf -o0 -e0)

# does this line read like a question waiting for an answer?
is_question() {
    local s="${1%"${1##*[![:space:]]}"}"      # strip trailing whitespace
    [[ -z $s ]] && return 1
    local re_brk='\[[^]]*[YyNn][^]]*\][:.]?$'      # ...[Y|n]   ...[y/N]:
    local re_par='\([YyNn][^)]*\)[:.]?$'           # ...(y/n):
    local re_end='[:?][[:space:]]*$'
    local re_kw='(Is this ok|Perform operation|Continue|Proceed|Confirm|password|Choose|Select)'
    [[ $s == *'?' ]]     && return 0               # ...continue?
    [[ $s =~ $re_brk ]]  && return 0
    [[ $s =~ $re_par ]]  && return 0
    # a keyword prompt that ends where an answer would go
    [[ $s =~ $re_end && $s =~ $re_kw ]] && return 0
    return 1
}

ask_begin() {
    local label="$1" text="$2"
    (( LIVE_DRAWN )) && printf '\e[%dA' "$LIVE_LINES"
    LIVE_DRAWN=0
    printf '\a'                                   # una domanda si deve anche sentire
    printf '\r   %s◈%s  %s%s — the command is asking:%s\e[K\n' \
        "$GOLD" "$RESET" "$GOLD$BOLD" "$label" "$RESET"
    printf '\r      %s│%s %s\e[K\n' "$GOLD" "$RESET" "$text"
    printf '\r      %s│%s %stype the answer + ENTER (goes straight to the command)%s\e[K\n' \
        "$GOLD" "$RESET" "$DIM" "$RESET"
    printf '\r      %s➜%s \e[K' "$GOLD" "$RESET"
    printf '\e[?25h'
}

# the command produced output again: hide the cursor and resume the pipeline
ask_end() { printf '\e[?25l\n'; }

# Idle-tick prompt detector shared by every streaming runner. Called once per
# poll timeout with the runner's own state variables (passed by name):
#   poll_prompt <label> <pending> <stall> <asking> <last_line> <log>
poll_prompt() {
    local _lbl=$1 _log=$6
    local -n _p=$2 _s=$3 _a=$4 _l=$5
    (( _a )) && return                       # already waiting for the user
    _s=$(( _s + 1 ))
    if [[ -n $_p ]]; then                    # unterminated line → fast trigger
        (( _s >= 15 )) || return
        printf '%s\n' "$_p" >>"$_log"
        ask_begin "$_lbl" "$_p"
        _p=''; _a=1
    elif (( _s >= QUIET_TICKS )) && is_question "$_l"; then   # silence → slow trigger
        ask_begin "$_lbl" "$_l"; _a=1
    fi
}

#== Plain spinner step (no per-package progress: e.g. cromup) =================
run_step() {
    local label="$1"; shift
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector
    # <&0 is not decoration: bash gives an asynchronous command /dev/null for
    # stdin, so without it the command would hit EOF the moment it asked
    # anything — the question would show up on screen with no way to answer it.
    "$@" >"$log" 2>&1 <&0 &
    local pid=$! i=0 start=$SECONDS
    local asking=0 stall=0 last_size=0 size
    while kill -0 "$pid" 2>/dev/null; do
        # a log that stopped growing on an unterminated line is a pending prompt
        size=$(stat -c %s "$log" 2>/dev/null || echo 0)
        if (( size != last_size )); then
            last_size=$size; stall=0
            (( asking )) && { ask_end; asking=0; }
        elif (( ! asking && size > 0 )); then
            stall=$(( stall + 1 ))
            if [[ -n $(tail -c 1 "$log") ]]; then
                # unterminated line: a prompt, surface it quickly
                (( stall >= 15 )) && { ask_begin "$label" "$(tail -n 1 "$log")"; asking=1; }
            elif (( stall >= QUIET_TICKS )) && is_question "$(tail -n 1 "$log")"; then
                # long silence after a question printed with its newline
                ask_begin "$label" "$(tail -n 1 "$log")"; asking=1
            fi
        fi
        if (( ! asking )); then
            printf '\r   %s%s%s  %s   %s%s%s\e[K' \
                "$CYAN" "${SPIN[i%6]}" "$RESET" "$label" "$DIM" "$(fmt_time $(( SECONDS - start )))" "$RESET"
        fi
        i=$(( i + 1 )); sleep 0.12
    done
    (( asking )) && { ask_end; asking=0; }
    wait "$pid"; local rc=$?
    if (( rc == 0 )); then
        printf '\r   %s●%s  %s\e[K\n' "$GREEN" "$RESET" "$label"
        steps_ok=$(( steps_ok + 1 ))
    else
        printf '\r   %s✗%s  %s%s%s\e[K\n' "$RED" "$RESET" "$RED" "$label" "$RESET"
        steps_fail=$(( steps_fail + 1 ))
        error_box "$log"
    fi
    drop_log "$log" "$label"
}

#== Planning: resolve every section up-front so the TOTAL is known ============

# count packages in a dnf transaction summary; the command is run with "n"
# piped in so dnf resolves (and refreshes), prints the summary, then aborts
dnf_plan_count() {
    printf 'n\n' | "$@" 2>/dev/null | awk '
        /^[[:space:]]*(Installing|Upgrading|Removing|Reinstalling|Downgrading|Obsoleting):[[:space:]]+[0-9]+/ {
            for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+$/) { s += $i; break }
        }
        END { print s + 0 }'
}

# list Flatpak refs needing an update (mode=update) or that are unused (mode=unused)
flatpak_refs() {
    if [[ $1 == update ]]; then
        env LC_ALL=C flatpak update --no-deploy 2>/dev/null
    else
        printf 'n\n' | env LC_ALL=C flatpak uninstall --unused 2>/dev/null
    fi | awk -F'\t' '/^[[:space:]]*[0-9]+\./ { gsub(/^[ \t]+|[ \t]+$/,"",$3); if ($3!="") print $3 }'
}

# Devices with a pending firmware update, one "DeviceId<TAB>Name" line each.
# fwupd stages most updates and applies them at the next boot, which is exactly
# the class of update the pipeline used to skip.
fw_updates() {
    command -v fwupdmgr >/dev/null 2>&1 || return 0
    # refresh the LVFS metadata; it exits non-zero when already fresh — harmless
    sudo env LC_ALL=C fwupdmgr refresh --force >/dev/null 2>&1
    local json
    json=$(env LC_ALL=C fwupdmgr get-updates --json 2>/dev/null) || return 0
    if command -v jq >/dev/null 2>&1; then
        printf '%s' "$json" | jq -r '.Devices[]? | "\(.DeviceId)\t\(.Name // "firmware")"' 2>/dev/null
    else
        printf '%s' "$json" | grep -oP '"DeviceId"[[:space:]]*:[[:space:]]*"\K[^"]+' | sed 's/$/\tfirmware/'
    fi
}

# The next Fedora release, but only once it is actually published ('' otherwise).
next_release() {
    local cur next
    cur=$(rpm -E %fedora 2>/dev/null)
    [[ $cur =~ ^[0-9]+$ ]] || return 0
    next=$(( cur + 1 ))
    curl -fsS --max-time 10 -o /dev/null \
        "https://dl.fedoraproject.org/pub/fedora/linux/releases/$next/Everything/$(uname -m)/os/repodata/repomd.xml" \
        2>/dev/null && printf '%s' "$next"
}

plan_phase() {
    connector
    local tmp; tmp=$(mktemp)
    (
        upg=$(dnf_plan_count  sudo env LC_ALL=C dnf upgrade --refresh)
        auto=$(dnf_plan_count sudo env LC_ALL=C dnf autoremove)
        mapfile -t fu < <(flatpak_refs update)
        mapfile -t fx < <(flatpak_refs unused)
        mapfile -t fw < <(fw_updates)
        # /system-update is the systemd trigger both dnf and PackageKit create
        # when an update is staged to be installed at the next boot
        offl=0; [ -e /system-update ] && offl=1
        nrel=$(next_release)
        {
            printf 'P_UPG=%d\n'  "${upg:-0}"
            printf 'P_AUTO=%d\n' "${auto:-0}"
            printf 'P_OFFL=%d\n' "$offl"
            printf 'P_NREL=%s\n' "$nrel"
            printf 'FU=%s\n' "$(printf '%s\n' "${fu[@]}")"
            printf '__FUEND__\n'
            printf 'FX=%s\n' "$(printf '%s\n' "${fx[@]}")"
            printf '__FXEND__\n'
            printf 'FW=%s\n' "$(printf '%s\n' "${fw[@]}")"
            printf '__FWEND__\n'
        } > "$tmp"
    ) &
    local pid=$! i=0 start=$SECONDS
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r   %s%s%s  %s   %s%s%s\e[K' \
            "$CYAN" "${SPIN[i%6]}" "$RESET" "Planning updates" "$DIM" "$(fmt_time $(( SECONDS - start )))" "$RESET"
        i=$(( i + 1 )); sleep 0.12
    done
    wait "$pid"

    # parse the plan
    DNF_UPG=$(sed -n 's/^P_UPG=//p'  "$tmp"); DNF_UPG=${DNF_UPG:-0}
    DNF_AUTO=$(sed -n 's/^P_AUTO=//p' "$tmp"); DNF_AUTO=${DNF_AUTO:-0}
    OFFLINE_PENDING=$(sed -n 's/^P_OFFL=//p' "$tmp"); OFFLINE_PENDING=${OFFLINE_PENDING:-0}
    NEXT_REL=$(sed -n 's/^P_NREL=//p' "$tmp")
    mapfile -t FU_REFS < <(sed -n '/^FU=/,/^__FUEND__$/p' "$tmp" | sed '1s/^FU=//; /^__FUEND__$/d; /^$/d')
    mapfile -t FX_REFS < <(sed -n '/^FX=/,/^__FXEND__$/p' "$tmp" | sed '1s/^FX=//; /^__FXEND__$/d; /^$/d')
    local fw_lines fwl
    mapfile -t fw_lines < <(sed -n '/^FW=/,/^__FWEND__$/p' "$tmp" | sed '1s/^FW=//; /^__FWEND__$/d; /^$/d')
    FW_IDS=(); FW_NAMES=()
    for fwl in "${fw_lines[@]}"; do
        FW_IDS+=("${fwl%%$'\t'*}"); FW_NAMES+=("${fwl#*$'\t'}")
    done
    rm -f "$tmp"

    local nfu=${#FU_REFS[@]} nfx=${#FX_REFS[@]} nfw=${#FW_IDS[@]}
    G_TOTAL_PKG=$(( DNF_UPG + DNF_AUTO + nfu + nfx + nfw ))

    # Carve the 0..1000 bar into download / install / flatpak / firmware bands,
    # weighted 30/40/20/10 — but a phase with no work hands its weight to the
    # others, so the present phases always stretch to fill the whole bar.
    local in_tot=$(( DNF_UPG + DNF_AUTO )) fp_tot=$(( nfu + nfx ))
    local wdl=0 win=0 wfp=0 wfw=0
    (( DNF_UPG > 0 )) && wdl=30
    (( in_tot   > 0 )) && win=40
    (( fp_tot   > 0 )) && wfp=20
    (( nfw      > 0 )) && wfw=10
    local w=$(( wdl + win + wfp + wfw )); (( w == 0 )) && w=1

    B_DLU_HI=$(( 1000 * wdl / w ))                         # end of download band
    local in_lo=$B_DLU_HI in_span=$(( 1000 * win / w ))
    local in_hi=$(( in_lo + in_span ))
    # split the install band between upgrade and autoremove by package count
    B_INU_HI=$(( in_tot > 0 ? in_lo + in_span * DNF_UPG / in_tot : in_lo ))
    B_INA_HI=$in_hi
    # flatpak band, split update vs remove by ref count
    local fp_lo=$in_hi fp_span=$(( 1000 * wfp / w ))
    local fp_hi=$(( fp_lo + fp_span ))
    B_FPU_HI=$(( fp_tot > 0 ? fp_lo + fp_span * nfu / fp_tot : fp_lo ))
    B_FPX_HI=$fp_hi
    # firmware takes whatever is left, so the bar always ends at 1000
    (( wfw == 0 )) && B_FPX_HI=1000

    draw_total_footer 0
    printf '\r   %s●%s  Planning complete  %s(%d item(s) to process%s)%s\e[K\n' \
        "$GREEN" "$RESET" "$DIM" "$G_TOTAL_PKG" \
        "$( (( nfw > 0 )) && printf ', %d firmware' "$nfw" )" "$RESET"
}

#== Broken-state auto-repair (escalating) ====================================
# Set to 1 around a step where a depsolve failure is an expected answer rather
# than a symptom (the release upgrade), so run_dnf reports it instead of
# "repairing" a system that is not broken.
NO_AUTOREPAIR=0

# dnf has no `--fix-broken`. When a transaction dies leaving the RPM state
# inconsistent (corrupt rpmdb, stale metadata, unfinished/duplicate packages,
# unmet deps), run_dnf detects it from the command log and self-heals in two
# escalating rungs before retrying the step in place:
#   L1 (safe)  : dnf clean all + rpm --rebuilddb — repairs cache & rpmdb, no
#                package changes at all.
#   L2 (deep)  : dnf distro-sync — resyncs to the repos, resolving broken deps
#                and leftover half-transactions (MAY downgrade packages). Only
#                reached if L1 ran and the state STILL looks broken.

# does the command log look like a broken / interrupted RPM state?
dnf_looks_broken() {
    grep -qiE 'rpmdb|rpm database|cannot open packages|depsolve|nothing provides|conflicts with file|file .* conflicts|transaction (test|check) error|could not run transaction|unfinished transaction|broken (dependencies|packages)|duplicate' "$1"
}

# L1 — safe repair (no package changes)
_recover_dnf_l1() {
    sudo env LC_ALL=C dnf clean all
    sudo rpm --rebuilddb
}

# L2 — deep repair (may downgrade to match the repos)
_recover_dnf_l2() {
    sudo env LC_ALL=C dnf -y distro-sync
}

#== DNF step with download + transaction progress ============================
# run_dnf "Label" "Install|Remove" dl_lo dl_hi in_lo in_hi sudo env LC_ALL=C dnf ...
# The download phase fills the TOTAL bar's [dl_lo,dl_hi] band, the transaction
# fills [in_lo,in_hi]; dl_lo==dl_hi means "this step never downloads".
run_dnf() {
    local label="$1" p2="$2" dl_lo="$3" dl_hi="$4" in_lo="$5" in_hi="$6"; shift 6
    local cmd=("$@")
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector

    local re='^\[[[:space:]]*([0-9]+)/[[:space:]]*([0-9]+)\][[:space:]]+(.*)$'

    # Run the transaction; on a broken/interrupted failure, self-heal in two
    # escalating rungs (L1 safe, L2 deep) and retry the same step in place.
    local rc=-1 attempt
    for attempt in 1 2 3; do
        local phase=resolve
        local dl_done=0 dl_total=0 in_done=0 in_total=0
        local counter="resolving…"
        local start=$SECONDS i=0 fd
        rc=-1
        (( attempt >= 2 )) && counter="retrying after repair…"
        exec {fd}< <( { "${cmd[@]}"; printf '\n__RC__%d__\n' "$?"; } 2>&1 )

        render_live "${SPIN[0]}" "$label" '00:00' "$counter" 0 1
        draw_total_footer "$dl_lo"

        local pending='' stall=0 asking=0 last_line=''
        while true; do
            line=''
            if IFS= read -t 0.12 -r -u "$fd" line; then
                (( asking )) && { ask_end; asking=0; }
                [[ -n $pending ]] && { line="$pending$line"; pending=''; }
                stall=0
                case "$line" in __RC__*__) rc=${line#__RC__}; rc=${rc%__}; continue;; esac
                printf '%s\n' "$line" >>"$log"
                last_line="$line"
                [[ $line == "Running transaction"* ]] && phase=install
                if [[ $line =~ $re ]]; then
                    local n=${BASH_REMATCH[1]} m=${BASH_REMATCH[2]} rest=${BASH_REMATCH[3]}
                    local name; name=$(clean_name "$rest")
                    if [[ $name != "Total" ]]; then
                        if [[ $phase == install ]]; then
                            in_total=$m; in_done=$n; counter="$p2 $n/$m: $(strip_verb "$name")"
                        else
                            dl_total=$m; dl_done=$n; counter="Download $n/$m: $name"
                        fi
                    fi
                fi
            else
                (( $? > 128 )) || break
                # timeout: read leaves any newline-less partial input in $line —
                # a line that then stays unfinished is a prompt awaiting an answer
                if [[ -n $line ]]; then
                    pending+="$line"; stall=0
                else
                    poll_prompt "$label" pending stall asking last_line "$log"
                fi
            fi
            (( asking )) && continue           # UI frozen while the user answers
            # section bar (download = first half, install = second half) and the
            # absolute TOTAL position within this step's two bands
            local f=0 pm=$dl_lo
            if   (( in_total > 0 )); then
                f=$(( dl_total > 0 ? 500 * dl_done / dl_total + 500 * in_done / in_total : 1000 * in_done / in_total ))
                pm=$(( in_lo + (in_hi - in_lo) * in_done / in_total ))
            elif (( dl_total > 0 )); then
                f=$(( 500 * dl_done / dl_total ))
                pm=$(( dl_lo + (dl_hi - dl_lo) * dl_done / dl_total ))
            fi
            render_live "${SPIN[i%6]}" "$label" "$(fmt_time $(( SECONDS - start )))" "$counter" "$f" 1000
            draw_total_footer "$pm"
            i=$(( i + 1 ))
        done
        exec {fd}<&-
        (( asking )) && { ask_end; asking=0; }
        [[ -n $pending ]] && printf '%s\n' "$pending" >>"$log"

        (( rc == 0 )) && break
        # Failure that looks like a broken RPM state: collapse to a warning,
        # run the next repair rung, then loop to retry. L1 on the 1st failure,
        # L2 on the 2nd; the 3rd failure falls through to the error box.
        if (( attempt < 3 && ! NO_AUTOREPAIR )) && dnf_looks_broken "$log"; then
            if (( attempt == 1 )); then
                finish_node '⚠' "$GOLD" "$label — broken state detected, repairing (rpmdb/cache)…"
                run_step "Repairing RPM state (clean + rebuilddb)" _recover_dnf_l1
            else
                finish_node '⚠' "$GOLD" "$label — still broken, deep repair (distro-sync)…"
                run_step "Deep repair (dnf distro-sync)" _recover_dnf_l2
            fi
            connector
            : > "$log"                         # fresh log for the retry
        else
            break
        fi
    done

    draw_total_footer "$in_hi"
    if (( rc == 0 )); then
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 ))
    else
        finish_node '✗' "$RED" "$label"; steps_fail=$(( steps_fail + 1 )); error_box "$log"
    fi
    drop_log "$log" "$label"
}

#== Flatpak section: update or remove one ref at a time ======================
# run_flatpak "Label" update|remove lo hi ref...
# Fills the TOTAL bar's [lo,hi] band as the refs complete.
run_flatpak() {
    local label="$1" mode="$2" lo="$3" hi="$4"; shift 4
    local refs=("$@") N=$#
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector

    local verb; [[ $mode == update ]] && verb=Update || verb=Remove

    if (( N == 0 )); then
        render_live "${SPIN[0]}" "$label" '00:00' 'nothing to do' 1 1
        draw_total_footer "$hi"
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 )); drop_log "$log" "$label"; return
    fi

    local rc=0 start=$SECONDS i=0 idx=0 ref
    for ref in "${refs[@]}"; do
        idx=$(( idx + 1 ))
        local cur_pct=0 lrc=0 fd
        if [[ $mode == update ]]; then
            exec {fd}< <( { "${UNBUF[@]}" env LC_ALL=C flatpak update -y "$ref"; printf '\n__RC__%d__\n' "$?"; } 2>&1 )
        else
            exec {fd}< <( { "${UNBUF[@]}" env LC_ALL=C flatpak uninstall -y "$ref"; printf '\n__RC__%d__\n' "$?"; } 2>&1 )
        fi
        local pending='' stall=0 asking=0 last_line=''
        while true; do
            line=''
            if IFS= read -t 0.12 -r -u "$fd" line; then
                (( asking )) && { ask_end; asking=0; }
                [[ -n $pending ]] && { line="$pending$line"; pending=''; }
                stall=0
                case "$line" in __RC__*__) lrc=${line#__RC__}; lrc=${lrc%__}; continue;; esac
                printf '%s\n' "$line" >>"$log"
                last_line="$line"
                [[ $line =~ ([0-9]+)%[^0-9]*$ ]] && cur_pct=${BASH_REMATCH[1]}
            else
                (( $? > 128 )) || break
                # timeout: read leaves any newline-less partial input in $line —
                # a line that then stays unfinished is a prompt awaiting an answer
                if [[ -n $line ]]; then
                    pending+="$line"; stall=0
                else
                    poll_prompt "$label" pending stall asking last_line "$log"
                fi
            fi
            (( asking )) && continue           # UI frozen while the user answers
            local sd=$(( (idx - 1) * 1000 + cur_pct * 10 ))
            render_live "${SPIN[i%6]}" "$label" "$(fmt_time $(( SECONDS - start )))" \
                "$verb $idx/$N: $ref" "$sd" "$(( N * 1000 ))"
            draw_total_footer $(( lo + (hi - lo) * sd / (N * 1000) ))
            i=$(( i + 1 ))
        done
        exec {fd}<&-
        (( asking )) && { ask_end; asking=0; }
        [[ -n $pending ]] && printf '%s\n' "$pending" >>"$log"
        (( lrc != 0 )) && rc=1
    done

    draw_total_footer "$hi"
    if (( rc == 0 )); then
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 ))
    else
        finish_node '✗' "$RED" "$label"; steps_fail=$(( steps_fail + 1 )); error_box "$log"
    fi
    drop_log "$log" "$label"
}

#== Firmware section (fwupd) =================================================
# run_fw "Label" lo hi device-id...
# Flashes one device at a time, filling the TOTAL bar's [lo,hi] band.
#
# ATTENZIONE — qui fwupd NON fa domande, e non è una scelta di questo script.
#
# fwupd decide se è "interattivo" guardando soltanto il proprio stdout
# (fu_console_setup → isatty(stdout)). Qui lo stdout è la pipe che alimenta
# questa interfaccia, quindi si dichiara non interattivo e in quel ramo (main(),
# src/fu-util.c) accende da solo no_safety_check, no_reboot_check,
# no_metadata_check, no_unreported_check e no_device_prompt. Ogni domanda di
# `fwupdmgr update` sta dietro a uno di quei flag, quindi non ne viene posta
# nessuna: né l'avviso del produttore ("il dispositivo deve restare collegato",
# l'avviso sulla cifratura del disco), né "Perform operation?", né la proposta
# di riavvio. Il rilevatore di prompt, su questa sezione, non vedrà mai niente.
#
# Quindi: il firmware viene installato senza conferma, e senza mostrare gli
# avvisi del produttore. L'unico modo per riaverli sarebbe dare a fwupd un
# terminale vero (un pty), non un flag.
#
# --no-reboot-check resta scritto a mano anche se fwupd lo accenderebbe da sé:
# il riavvio va proposto una volta sola, alla fine, e non deve dipendere da come
# fwupd classifica il proprio stdout.
run_fw() {
    local label="$1" lo="$2" hi="$3"; shift 3
    local ids=("$@") N=$#
    local log; log=$(mktemp)
    trace "inizio: $label"
    connector

    if (( N == 0 )); then
        render_live "${SPIN[0]}" "$label" '00:00' 'no firmware updates' 1 1
        draw_total_footer "$hi"
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 )); drop_log "$log" "$label"; return
    fi

    local rc=0 start=$SECONDS i=0 idx=0 id
    for id in "${ids[@]}"; do
        idx=$(( idx + 1 ))
        local name="${FW_NAMES[idx-1]:-$id}"
        local cur_pct=0 lrc=0 fd
        # fwupd redraws its progress bar with \r; turning those into real lines
        # keeps the prompt detector from reading a redrawing bar as a question.
        # tr must be unbuffered too, or it would hold back the very question we
        # need to show — a buffered tr swallows it until the next flush.
        exec {fd}< <( { sudo "${UNBUF[@]}" env LC_ALL=C fwupdmgr update --no-reboot-check "$id" 2>&1
                        printf '\n__RC__%d__\n' "$?"; } | "${UNBUF[@]}" tr '\r' '\n' )
        local pending='' stall=0 asking=0 last_line=''
        while true; do
            line=''
            if IFS= read -t 0.12 -r -u "$fd" line; then
                (( asking )) && { ask_end; asking=0; }
                [[ -n $pending ]] && { line="$pending$line"; pending=''; }
                stall=0
                case "$line" in __RC__*__) lrc=${line#__RC__}; lrc=${lrc%__}; continue;; esac
                printf '%s\n' "$line" >>"$log"
                last_line="$line"
                [[ $line =~ ([0-9]+)%[^0-9]*$ ]] && cur_pct=${BASH_REMATCH[1]}
            else
                (( $? > 128 )) || break
                if [[ -n $line ]]; then
                    pending+="$line"; stall=0
                else
                    poll_prompt "$label" pending stall asking last_line "$log"
                fi
            fi
            (( asking )) && continue           # UI frozen while the user answers
            local sd=$(( (idx - 1) * 1000 + cur_pct * 10 ))
            render_live "${SPIN[i%6]}" "$label" "$(fmt_time $(( SECONDS - start )))" \
                "Flash $idx/$N: $name" "$sd" "$(( N * 1000 ))"
            draw_total_footer $(( lo + (hi - lo) * sd / (N * 1000) ))
            i=$(( i + 1 ))
        done
        exec {fd}<&-
        (( asking )) && { ask_end; asking=0; }
        [[ -n $pending ]] && printf '%s\n' "$pending" >>"$log"
        (( lrc != 0 && lrc != 2 )) && rc=1     # 2 = fwupd found nothing to do
    done

    draw_total_footer "$hi"
    if (( rc == 0 )); then
        finish_node '●' "$GREEN" "$label"; steps_ok=$(( steps_ok + 1 ))
    else
        finish_node '✗' "$RED" "$label"; steps_fail=$(( steps_fail + 1 )); error_box "$log"
    fi
    drop_log "$log" "$label"
}

#== Staged offline updates (Discover / GNOME Software) =======================
# Those front-ends do not install updates live: they download them and leave a
# transaction staged behind /system-update, so the packages are only applied on
# the next boot — which is why they look like "updates that need a reboot" and
# why this pipeline never saw them. Since we install the very same packages
# live, a few lines below, the staged copy is stale: clearing it up front avoids
# a pointless (and possibly failing) offline transaction at the next boot.
_clear_offline() {
    # whichever front-end staged it, only one of these two owns the transaction
    sudo env LC_ALL=C dnf offline clean || true
    command -v pkcon >/dev/null 2>&1 && { sudo env LC_ALL=C pkcon offline-cancel || true; }
    [ -e /system-update ] && sudo rm -f /system-update
    [ ! -e /system-update ]                  # the step is done when the trigger is gone
}

#== Reboot detection =========================================================
# Packages whose update genuinely only takes effect after a restart — dnf4's
# `needs-restarting -r` list, minus the kernel (handled separately, by version).
#
# dnf5's own needs-restarting is NOT usable as the verdict: it announces "core
# libraries or services have been updated since boot-up" and then lists every
# package updated since boot — grub2, icon themes, kf6 libraries and all. That
# turns into "reboot required" after any update whatsoever, which is noise: a
# reboot notice nobody can trust is worse than no notice.
REBOOT_CORE_PKGS='^(glibc|systemd|systemd-libs|systemd-udev|systemd-shared|dbus|dbus-broker|dbus-daemon|dbus-common|linux-firmware|microcode_ctl)$'

# Fill REBOOT_REASONS with everything that only takes effect after a restart.
detect_reboot_needed() {
    REBOOT_REASONS=()

    # kernel: newest installed vs the one actually running
    local newest running
    running=$(uname -r)
    newest=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core 2>/dev/null | sort -V | tail -1)
    [[ -n $newest && $newest != "$running" ]] && REBOOT_REASONS+=("new kernel installed: $newest")

    # core packages whose files were replaced after this boot: the running
    # processes still hold the old ones until the machine restarts
    local boot_epoch core
    boot_epoch=$(( $(date +%s) - $(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0) ))
    core=$(rpm -qa --qf '%{INSTALLTIME} %{NAME}\n' 2>/dev/null |
           awk -v b="$boot_epoch" '$1 > b { print $2 }' |
           grep -E "$REBOOT_CORE_PKGS" | sort -u | tr '\n' ' ')
    core=${core% }
    [[ -n $core ]] && REBOOT_REASONS+=("core packages updated since boot: $core")

    # firmware staged by fwupd, applied by the firmware itself at the next boot
    if command -v fwupdmgr >/dev/null 2>&1 &&
       env LC_ALL=C fwupdmgr check-reboot-needed >/dev/null 2>&1; then
        REBOOT_REASONS+=("firmware update waiting to be applied at boot")
    fi

    (( ${#REBOOT_REASONS[@]} > 0 ))
}

#== Domande sì/no poste dallo script stesso ==================================
# Il prompt non viene affidato a `read -p`. Bash stampa il prompt di `read -p`
# soltanto quando lo stdin del read è un terminale, e lo manda su stderr: basta
# che lo script venga lanciato con stdin diverso dal terminale (una pipe, un
# redirect, un lanciatore che passa stdin altrove) perché la domanda sparisca
# del tutto mentre il read continua ad aspettare. È il modo peggiore di
# sbagliare: si resta fermi davanti a uno schermo muto, a rispondere alla cieca.
# Qui il prompt lo stampiamo noi, e la risposta la leggiamo dal terminale vero.
#
# ask_read <variabile> — legge una riga dal terminale, non da stdin. Se non
# esiste un terminale di controllo ripiega su stdin; se non c'è nemmeno quello
# la risposta resta vuota (che per una domanda y/N vuol dire "no", la scelta
# prudente) invece di bloccare lo script per sempre.
ask_read() {
    local -n _ans=$1
    _ans=''
    if [ -r /dev/tty ]; then
        IFS= read -r _ans < /dev/tty || _ans=''
    else
        IFS= read -r _ans || _ans=''
    fi
}

ask_yes_no() {
    local prompt="$1" ans
    trace "chiedo: $prompt"
    printf '\e[?25h'
    printf '\a'                                   # una domanda si deve anche sentire
    printf '   %s◈%s  %s %s[y/N]%s ' "$GOLD" "$RESET" "$prompt" "$DIM" "$RESET"
    ask_read ans
    printf '\e[?25l'
    trace "risposta: '$ans'"
    [[ $ans =~ ^([yY]|[yY][eE][sS]|[sS]|[sS][iI])$ ]]
}

#== Disclaimer ===============================================================
# Mostrato a ogni avvio, prima di toccare qualsiasi cosa e prima ancora di
# chiedere la password: due funzioni non sono mai state eseguite su un caso
# reale, e un aggiornamento di sistema andato male non è un problema piccolo.
# Chi lancia lo script deve poterlo sapere e potersi fermare a costo zero.
disclaimer() {
    local rule; rule=$(rep 68 '─')
    printf "   %s⚠  AVVISO DI RESPONSABILITÀ — LEGGI PRIMA DI CONTINUARE%s\n" "$GOLD$BOLD" "$RESET"
    printf "   %s%s%s\n" "$DIM" "$rule" "$RESET"
    printf "      %sAGGIORNA%s esegue una sequenza di comandi di sistema (dnf, flatpak,\n" "$BOLD" "$RESET"
    printf "      fwupdmgr) per aggiornare Fedora, e su richiesta può portare il\n"
    printf "      sistema operativo a una nuova versione.\n\n"
    printf "      Sono operazioni che modificano il sistema in profondità. Per quanto\n"
    printf "      lo script sia scritto con cura, un imprevisto resta sempre possibile:\n"
    printf "      un aggiornamento interrotto, un pacchetto difettoso o un firmware\n"
    printf "      andato storto possono lasciare il sistema instabile o non avviabile.\n\n"
    printf "      AGGIORNA è distribuito %ssenza alcuna garanzia%s, come previsto dalle\n" "$BOLD" "$RESET"
    printf "      sezioni 15 e 16 della licenza GNU GPL v3. %sL'autore non risponde di\n" "$BOLD"
    printf "      danni, perdita di dati o sistemi resi inutilizzabili%s derivanti\n" "$RESET"
    printf "      dall'uso dello script.\n\n"
    printf "      %sContinuando, dichiari di usare AGGIORNA a tuo rischio e di assumerti\n" "$GOLD"
    printf "      la piena responsabilità delle modifiche apportate al tuo sistema.%s\n\n" "$RESET"
    printf "      %sSe hai dati importanti, fai un backup prima di procedere.%s\n" "$DIM" "$RESET"
    printf "      %sNota: il passaggio di versione e la gestione degli aggiornamenti in\n" "$DIM"
    printf "      coda per il riavvio non sono ancora stati provati su un caso reale.%s\n" "$RESET"
    printf "   %s%s%s\n\n" "$DIM" "$rule" "$RESET"

    if ! ask_yes_no "Accetti e vuoi continuare?"; then
        exit_clean "   ${DIM}Uscita: nessuna modifica effettuata.${RESET}" 0
    fi
    printf '\e[?25h'                      # la password va digitata a cursore visibile
    echo
}

#== Report card =============================================================
card_line() {
    local label="$1" value="$2" vcolor="$3"
    local inner=46
    local left="  ${label}"
    local pad=$(( inner - ${#left} - ${#value} - 2 ))
    (( pad < 1 )) && pad=1
    printf '  %s│%s%s%*s%s%s%s  %s│%s\n' \
        "$CYAN" "$RESET" "$left" "$pad" '' "$vcolor" "$value" "$RESET" "$CYAN" "$RESET"
}

report_card() {
    local inner=46
    local rule; rule=$(rep "$inner" '─')
    local title='R E P O R T'
    local tpad=$(( (inner - ${#title}) / 2 ))

    echo
    printf '  %s╭%s╮%s\n' "$CYAN" "$rule" "$RESET"
    printf '  %s│%s%*s%s%s%s%*s%s│%s\n' \
        "$CYAN" "$RESET" "$tpad" '' "$GOLD$BOLD" "$title" "$RESET" \
        $(( inner - tpad - ${#title} )) '' "$CYAN" "$RESET"
    printf '  %s├%s┤%s\n' "$CYAN" "$rule" "$RESET"

    local ok_color="$GREEN"; (( steps_fail > 0 )) && ok_color="$GOLD"
    card_line "Operations succeeded" "${steps_ok}/$(( steps_ok + steps_fail ))" "$ok_color$BOLD"
    card_line "Packages processed"   "${G_TOTAL_PKG}"                            "$BOLD"
    card_line "Time elapsed"         "$(fmt_time "$SECONDS")"                     "$BOLD"
    local freed=$(( END_AVAIL - START_AVAIL ))
    if (( freed >= 0 )); then
        card_line "Space freed"  "$(kb_to_human "$freed")"   "$GREEN$BOLD"
    else
        card_line "Space used"   "$(kb_to_human "$(( -freed ))")" "$GOLD$BOLD"
    fi
    if (( ${#REBOOT_REASONS[@]} > 0 )) || (( SYSUP_STAGED )); then
        card_line "Reboot required" "yes" "$GOLD$BOLD"
    fi
    card_line "Script update" "$SCRIPT_UPDATE"            "$BOLD"

    printf '  %s╰%s╯%s\n' "$CYAN" "$rule" "$RESET"
    echo
}

#== Cleanup: reset the scroll region, restore the cursor, stop sudo keep-alive =
cleanup() {
    printf '\e[r'                                      # reset the scroll region
    printf '\e[?25h'                                   # show the cursor again
    [ -n "${SUDO_PID:-}" ] && kill "$SUDO_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

#== START ===================================================================
trace "avvio ($(uname -r), Fedora $(rpm -E %fedora 2>/dev/null), TERM=${TERM:-?}, stdin tty: $([ -t 0 ] && echo si || echo no))"
clear
setup_footer
header

# Nulla viene toccato finché l'utente non accetta
disclaimer

# Root credentials + keep-alive (steps read package-manager output through a
# pipe, so sudo must never stop to ask for the password mid-run)
